/* =========================================================
   DIRECTORY
========================================================= */

function Directory({
  data,
  category,
  setCategory,
  search,
  setSearch,
  favourites,
  toggleFavourite,
  admin,
  openEdit,
}) {
  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();

    return data.filter((item) => {
      const categoryMatch =
        category === "all" ||
        item.category === category;

      if (!categoryMatch) return false;

      if (!q) return true;

      return (
        String(item.name || "")
          .toLowerCase()
          .includes(q) ||
        String(item.location || "")
          .toLowerCase()
          .includes(q) ||
        String(item.description || "")
          .toLowerCase()
          .includes(q)
      );
    });
  }, [data, category, search]);

  return (
    <ScrollView
      style={styles.page}
      contentContainerStyle={styles.pageContent}
    >
      <Text style={styles.screenTitle}>
        🔎 Search Directory
      </Text>

      <Text style={styles.screenSub}>
        {filtered.length} results
      </Text>

      <TextInput
        value={search}
        onChangeText={setSearch}
        placeholder="எதை தேடுகிறீர்கள்?"
        placeholderTextColor="#94a3b8"
        style={styles.searchInput}
      />

      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        style={{ marginBottom: 14 }}
      >
        {CATEGORIES.map((c) => (
          <TouchableOpacity
            key={c[0]}
            style={[
              styles.chip,
              category === c[0] && styles.chipActive,
            ]}
            onPress={() => setCategory(c[0])}
          >
            <Text style={styles.chipIcon}>
              {c[1]}
            </Text>

            <Text
              style={[
                styles.chipText,
                category === c[0] &&
                  styles.chipTextActive,
              ]}
            >
              {c[2]}
            </Text>
          </TouchableOpacity>
        ))}
      </ScrollView>

      {filtered.map((item, index) => (
        <ListingCard
          key={`${item.name}-${index}`}
          item={item}
          favourite={!!favourites[item.name]}
          onFavourite={() =>
            toggleFavourite(item.name)
          }
          onAdminEdit={
            admin
              ? () => openEdit(item, index)
              : undefined
          }
        />
      ))}
    </ScrollView>
  );
}

