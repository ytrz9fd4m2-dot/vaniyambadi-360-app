                item={item}
                isAdmin={false}
                onEdit={() => {}}
              />
            )
          )}
        </ScrollView>
      </SafeAreaView>
    );
  }

  if (government) {
    return (
      <SafeAreaView style={styles.safe}>
        <View style={styles.pageHead}>
          <TouchableOpacity
            onPress={() =>
              setGovernment(false)
            }
          >
            <Text style={styles.back}>
              ‹ Back
            </Text>
          </TouchableOpacity>

          <Text style={styles.pageTitle}>
            🏛️ Government Help
          </Text>
        </View>

        <ScrollView
          contentContainerStyle={styles.list}
        >
          {GOVERNMENT.map(
            (item, index) => (
              <Card
                key={index}
                item={item}
                isAdmin={false}
                onEdit={() => {}}
              />
            )
          )}
        </ScrollView>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.safe}>
      {tab === "home" && (
        <Home
