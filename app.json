   MEMBER AUTH
========================================================= */

function MemberAuth({ onSuccess, onCancel }) {
  const [mode, setMode] = useState("join");
  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [area, setArea] = useState("");
  const [password, setPassword] = useState("");

  function submit() {
    if (!phone.trim() || !password.trim()) {
      Alert.alert(
        "Member",
        "Mobile மற்றும் Password உள்ளிடவும்."
      );
      return;
    }

    if (mode === "join" && !name.trim()) {
      Alert.alert("Member", "Name தேவை.");
      return;
    }

    Alert.alert(
      mode === "join" ? "Welcome 🎉" : "Login",
      "Prototype account successful.",
      [
        {
          text: "Continue",
          onPress: () =>
            onSuccess({
              name:
                name.trim() || "Member",
              phone: phone.trim(),
              area:
                area.trim() || "Vaniyambadi",
            }),
        },
      ]
    );
  }

  return (
    <SafeAreaView style={styles.safe}>
      <KeyboardAvoidingView
        style={{ flex: 1 }}
        behavior={
          Platform.OS === "ios"
            ? "padding"
            : undefined
        }
      >
        <ScrollView
          contentContainerStyle={styles.authPage}
        >
          <TouchableOpacity onPress={onCancel}>
            <Text style={styles.back}>‹ Back</Text>
          </TouchableOpacity>

          <PremiumIcon icon="👤" size={88} />

          <Text style={styles.authTitle}>
            VANIYAMBADI 360
          </Text>

          <Text style={styles.authSub}>
            {mode === "join"
              ? "Join as Member"
              : "Member Login"}
          </Text>

          {mode === "join" && (
            <>
              <Input
                label="Full Name"
                value={name}
                onChange={setName}
                placeholder="உங்கள் பெயர்"
              />

              <Input
                label="Area / ஊர்"
                value={area}
                onChange={setArea}
                placeholder="Vaniyambadi"
              />
            </>
          )}

          <Input
            label="Mobile Number"
            value={phone}
            onChange={setPhone}
            placeholder="Mobile Number"
            keyboardType="phone-pad"
          />

          <Input
            label="Password"
            value={password}
            onChange={setPassword}
            placeholder="Password"
          />

          <TouchableOpacity
            style={styles.primaryButton}
            onPress={submit}
          >
            <Text style={styles.primaryButtonText}>
              {mode === "join"
                ? "👤 Create Member Account"
                : "🔐 Login"}
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.switchButton}
            onPress={() =>
              setMode(
                mode === "join"
                  ? "login"
                  : "join"
              )
            }
          >
            <Text style={styles.switchText}>
              {mode === "join"
                ? "Already a Member? Login"
                : "New Member? Join Now"}
            </Text>
          </TouchableOpacity>
        </ScrollView>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

