  const [category, setCategory] =
    useState("all");

  const [search, setSearch] =
    useState("");

  const [admin, setAdmin] =
    useState(false);

  const [login, setLogin] =
    useState(false);

  const [emergency, setEmergency] =
    useState(false);

  const [government, setGovernment] =
    useState(false);

  const [editing, setEditing] =
    useState(null);

  if (login) {
    return (
      <AdminLogin
        onSuccess={() => {
          setLogin(false);
          setAdmin(true);
          setTab("admin");
        }}
        onCancel={() =>
          setLogin(false)
        }
      />
    );
  }

  if (editing) {
    return (
      <Edit
        item={editing}
        setData={setData}
        close={() =>
          setEditing(null)
        }
      />
    );
  }

  if (emergency) {
    return (
