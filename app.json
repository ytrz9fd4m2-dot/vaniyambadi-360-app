          ["📷", "Photos"],
          ["🎬", "Reels"],
          ["💎", "Membership"],
          ["📞", "Contacts"],
          ["📍", "Locations"],
          ["🛒", "Products"],
          ["⚙️", "Settings"],
        ].map(([icon, title]) => (
          <View
            key={title}
            style={styles.powerCard}
          >
            <Text style={styles.powerIcon}>
              {icon}
            </Text>

            <Text style={styles.powerText}>
              {title}
            </Text>
          </View>
        ))}
      </View>

      {/* ADD */}

      <View style={styles.adminForm}>
        <Text style={styles.adminFormTitle}>
          ＋ Add New Listing
        </Text>

        <Input
          label="Name"
          value={name}
          onChange={setName}
          placeholder="Shop / Hospital / School"
        />

        <Text style={styles.label}>
          Category
        </Text>

        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          style={{ marginBottom: 12 }}
        >
          {CATEGORIES
            .filter(
              (x) =>
                !["all"].includes(x[0])
            )
            .map((c) => (
              <TouchableOpacity
                key={c[0]}
                style={[
                  styles.chip,
                  category === c[0] &&
                    styles.chipActive,
                ]}
                onPress={() =>
                  setCategory(c[0])
                }
              >
                <Text style={styles.chipIcon}>
                  {c[1]}
                </Text>

                <Text
                  style={[
                    styles.chipText,
                    category === c[0] &&
                      styles.chipTextActive,
                  ]}
                >
                  {c[2]}
                </Text>
              </TouchableOpacity>
            ))}
        </ScrollView>

        <Input
          label="Location"
          value={location}
          onChange={setLocation}
          placeholder="Vaniyambadi"
        />

        <Input
          label="Phone"
          value={phone}
          onChange={setPhone}
          placeholder="Contact Number"
          keyboardType="phone-pad"
        />

        <TouchableOpacity
          style={styles.primaryButton}
          onPress={addListing}
        >
          <Text style={styles.primaryButtonText}>
            ＋ Add Listing
          </Text>
        </TouchableOpacity>
      </View>

      {/* LIST */}

      <Text style={styles.sectionTitle}>
        📋 Current Listings ({data.length})
      </Text>

      {data.slice(0, 60).map((item, index) => (
        <View
          key={`${item.name}-${index}`}
          style={styles.adminListing}
        >
          <View style={{ flex: 1 }}>
            <Text style={styles.adminListingName}>
              {item.name}
            </Text>

            <Text style={styles.adminListingInfo}>
              {categoryInfo(item.category)?.[1]}{" "}
              {item.location}
            </Text>
          </View>

          <TouchableOpacity
            style={styles.editMini}
            onPress={() =>
              onEdit(item, index)
            }
          >
            <Text>✏️</Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.deleteMini}
            onPress={() =>
              onDelete(index)
            }
          >
            <Text>🗑️</Text>
          </TouchableOpacity>
        </View>
      ))}
    </ScrollView>
  );
}

/* =========================================================
   EDIT LISTING
========================================================= */

function EditListing({
  item,
  onSave,
  onDelete,
  onBack,
}) {
  const [name, setName] = useState(
    item.name || ""
  );
  const [location, setLocation] = useState(
    item.location || ""
  );
  const [phone, setPhone] = useState(
    item.phone || ""
  );

  return (
    <ScrollView
      style={styles.page}
      contentContainerStyle={styles.pageContent}
    >
      <BackButton onPress={onBack} />

      <Text style={styles.screenTitle}>
        ✏️ Edit Listing
      </Text>

      <Input
        label="Name"
        value={name}
        onChange={setName}
        placeholder="Name"
      />

      <Input
        label="Location"
        value={location}
        onChange={setLocation}
        placeholder="Location"
      />

      <Input
        label="Phone"
        value={phone}
        onChange={setPhone}
        placeholder="Phone"
      />

      <TouchableOpacity
        style={styles.primaryButton}
        onPress={() =>
          onSave({
            ...item,
            name,
            location,
            phone,
          })
        }
      >
        <Text style={styles.primaryButtonText}>
          💾 Save Changes
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={styles.dangerButton}
        onPress={() => onDelete(item)}
      >
        <Text style={styles.dangerText}>
          🗑️ Delete Listing
        </Text>
      </TouchableOpacity>
    </ScrollView>
  );
}

/* =========================================================
   GOVERNMENT / EMERGENCY
========================================================= */

function SpecialList({
  title,
  icon,
  data,
  onBack,
}) {
  return (
    <ScrollView
