  );
}

/* =========================================================
   BACK
========================================================= */

function BackButton({ onPress }) {
  return (
    <TouchableOpacity
      onPress={onPress}
      style={styles.backButton}
    >
      <Text style={styles.back}>
        ‹ Back
      </Text>
    </TouchableOpacity>
  );
}

/* =========================================================
   APP
========================================================= */

export default function App() {
  const [data, setData] =
    useState(INITIAL_DATA);

  const [tab, setTab] =
    useState("home");

  const [category, setCategory] =
    useState("all");

  const [search, setSearch] =
    useState("");

  const [admin, setAdmin] =
    useState(false);

  const [adminLogin, setAdminLogin] =
    useState(false);

  const [member, setMember] =
    useState(null);

  const [favourites, setFavourites] =
    useState({});

  const [posts, setPosts] =
    useState([]);

  const [screen, setScreen] =
    useState(null);

  const [editing, setEditing] =
    useState(null);

  function toggleFavourite(name) {
    setFavourites((prev) => ({
      ...prev,
      [name]: !prev[name],
    }));
  }

  function addListing(item) {
    setData((prev) => [
      item,
      ...prev,
    ]);
  }

  function updateListing(item) {
    setData((prev) =>
      prev.map((x) =>
        x === editing?.item
          ? item
          : x
      )
    );

    setEditing(null);
  }

  function deleteListing(item) {
    Alert.alert(
      "Delete",
      `Delete ${item.name}?`,
      [
        {
          text: "Cancel",
          style: "cancel",
        },
        {
          text: "Delete",
          style: "destructive",
          onPress: () => {
            setData((prev) =>
              prev.filter(
                (x) => x !== item
              )
            );
            setEditing(null);
          },
        },
      ]
    );
  }

  function openAdmin() {
    if (admin) {
      setScreen("admin");
    } else {
      setAdminLogin(true);
    }
  }

  function openScreen(name) {
    setScreen(name);
  }

  function goHome() {
    setScreen(null);
    setTab("home");
  }

  if (adminLogin) {
    return (
      <AdminLogin
        onCancel={() =>
          setAdminLogin(false)
        }
        onSuccess={() => {
          setAdminLogin(false);
          setAdmin(true);
          setScreen("admin");
        }}
      />
    );
  }

  if (screen === "admin") {
    return (
      <SafeAreaView style={styles.safe}>
        <AdminPanel
          data={data}
          onBack={goHome}
          onAdd={addListing}
          onEdit={(item) =>
            setEditing({ item })
          }
          onDelete={(index) => {
            const item = data[index];

            Alert.alert(
              "Delete",
              `Delete ${item?.name}?`,
              [
                {
                  text: "Cancel",
                  style: "cancel",
                },
                {
                  text: "Delete",
                  style: "destructive",
                  onPress: () =>
                    setData((prev) =>
                      prev.filter(
                        (_, i) =>
                          i !== index
                      )
                    ),
                },
              ]
            );
          }}
        />
      </SafeAreaView>
    );
  }

  if (editing) {
    return (
      <SafeAreaView style={styles.safe}>
        <EditListing
          item={editing.item}
          onBack={() =>
            setEditing(null)
          }
          onSave={updateListing}
          onDelete={deleteListing}
        />
      </SafeAreaView>
    );
  }

  if (screen === "member") {
    if (member) {
      return (
        <SafeAreaView style={styles.safe}>
          <ScrollView
            style={styles.page}
            contentContainerStyle={
              styles.pageContent
            }
          >
            <BackButton onPress={goHome} />

            <View style={styles.profileHero}>
              <PremiumIcon
                icon="👤"
                size={90}
              />

              <Text style={styles.profileName}>
                {member.name}
              </Text>

              <Text style={styles.profileInfo}>
                📞 {member.phone}
              </Text>

              <Text style={styles.profileInfo}>
                📍 {member.area}
              </Text>
            </View>

            <FeatureCard
              icon="❤️"
              title="Favourite Shops"
              subtitle="Saved listings"
              onPress={() => {
                setCategory("shop");
                setTab("search");
                setScreen(null);
              }}
            />

            <TouchableOpacity
              style={styles.dangerButton}
              onPress={() =>
                setMember(null)
              }
            >
              <Text style={styles.dangerText}>
                Logout
              </Text>
            </TouchableOpacity>
          </ScrollView>
        </SafeAreaView>
      );
    }

    return (
      <MemberAuth
        onCancel={goHome}
        onSuccess={(m) => {
          setMember(m);
          goHome();
        }}
      />
    );
  }

  if (screen === "owner") {
    return (
      <SafeAreaView style={styles.safe}>
        <ShopOwner
          onBack={goHome}
          openScreen={openScreen}
        />
      </SafeAreaView>
    );
  }

  if (screen === "membership") {
    return (
      <SafeAreaView style={styles.safe}>
        <Membership onBack={goHome} />
      </SafeAreaView>
    );
  }

  if (
    screen === "posts" ||
    screen === "photos" ||
    screen === "reels"
  ) {
    return (
      <SafeAreaView style={styles.safe}>
        <ContentScreen
          type={screen}
          posts={posts}
          onBack={goHome}
          onCreate={() =>
            openScreen("createPost")
          }
        />
      </SafeAreaView>
    );
  }

  if (screen === "createPost") {
    return (
      <SafeAreaView style={styles.safe}>
        <CreatePost
          onBack={goHome}
          onPublish={(post) => {
            setPosts((prev) => [
              post,
              ...prev,
            ]);
            goHome();
          }}
        />
      </SafeAreaView>
    );
  }

  if (screen === "products") {
    return (
      <SafeAreaView style={styles.safe}>
        <ScrollView
          style={styles.page}
          contentContainerStyle={
            styles.pageContent
          }
        >
          <BackButton onPress={goHome} />

          <Text style={styles.screenTitle}>
            🛒 My Products
          </Text>

          <Text style={styles.screenSub}>
            Shop Owner Product Management
          </Text>

          <FeatureCard
            icon="＋"
            title="Add Product"
            subtitle="Coming in backend"
            onPress={() =>
              Alert.alert(
                "Products",
                "Product database can be connected next."
              )
            }
          />
        </ScrollView>
      </SafeAreaView>
    );
  }

  if (screen === "government") {
    return (
      <SafeAreaView style={styles.safe}>
        <SpecialList
          title="Government Help"
          icon="🏛️"
          data={GOVERNMENT}
          onBack={goHome}
        />
      </SafeAreaView>
    );
  }

  if (screen === "emergency") {
    return (
      <SafeAreaView style={styles.safe}>
        <SpecialList
          title="Emergency Help"
          icon="🚨"
          data={EMERGENCY}
          onBack={goHome}
        />
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.safe}>
      {tab === "home" && (
        <Home
          setCategory={(c) => {
            setCategory(c);
            setTab("search");
          }}
          openEmergency={() =>
            openScreen("emergency")
          }
          openGovernment={() =>
            openScreen("government")
          }
          openAdmin={openAdmin}
          openScreen={openScreen}
          member={member}
        />
      )}

      {tab === "search" && (
        <Directory
          data={data}
          category={category}
          setCategory={setCategory}
          search={search}
          setSearch={setSearch}
          favourites={favourites}
          toggleFavourite={
            toggleFavourite
          }
          admin={admin}
          openEdit={(item) =>
            setEditing({ item })
          }
        />
      )}

      {tab === "emergency" && (
        <SpecialList
          title="Emergency Help"
          icon="🚨"
          data={EMERGENCY}
          onBack={() => setTab("home")}
        />
      )}

      {tab === "admin" && (
        <AdminPanel
          data={data}
          onBack={() => setTab("home")}
          onAdd={addListing}
          onEdit={(item) =>
            setEditing({ item })
          }
          onDelete={(index) =>
            setData((prev) =>
              prev.filter(
                (_, i) => i !== index
              )
            )
          }
        />
      )}

      {/* BOTTOM NAV */}

      <View style={styles.bottomNav}>
        <NavButton
          icon="🏠"
          title="Home"
          active={tab === "home"}
          onPress={() => {
            setTab("home");
            setScreen(null);
          }}
        />

        <NavButton
          icon="🔎"
          title="Search"
          active={tab === "search"}
          onPress={() => {
            setTab("search");
            setScreen(null);
          }}
        />

        <NavButton
          icon="🚨"
          title="Emergency"
          active={tab === "emergency"}
          onPress={() => {
            setTab("emergency");
            setScreen(null);
          }}
        />

        <NavButton
          icon="⚙️"
          title="Admin"
          active={tab === "admin"}
          onPress={openAdmin}
        />
      </View>
    </SafeAreaView>
  );
}

/* =========================================================
   NAV BUTTON
========================================================= */

function NavButton({
  icon,
  title,
  active,
  onPress,
}) {
  return (
    <TouchableOpacity
      style={[
        styles.navButton,
        active && styles.navActive,
      ]}
      onPress={onPress}
    >
      <Text style={styles.navIcon}>
        {icon}
      </Text>

      <Text
        style={[
          styles.navText,
          active && styles.navTextActive,
        ]}
      >
        {title}
      </Text>
    </TouchableOpacity>
  );
}

