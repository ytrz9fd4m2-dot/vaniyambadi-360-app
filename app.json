/* =========================================================
   ACTION BUTTON
========================================================= */

function ActionButton({ icon, title, onPress, type = "normal" }) {
  return (
    <TouchableOpacity
      style={[
        styles.actionButton,
        type === "danger" && styles.actionDanger,
        type === "green" && styles.actionGreen,
      ]}
      onPress={onPress}
    >
      <Text style={styles.actionIcon}>{icon}</Text>
      <Text style={styles.actionText}>{title}</Text>
    </TouchableOpacity>
  );
}

/* =========================================================
   LISTING CARD
========================================================= */

function ListingCard({
  item,
  onAdminEdit,
  favourite,
  onFavourite,
}) {
  const info = categoryInfo(item.category);

  return (
    <View style={styles.card}>
      <View style={styles.cardTop}>
        <PremiumIcon
          icon={info ? info[1] : "📌"}
          size={54}
        />

        <View style={{ flex: 1, marginLeft: 12 }}>
          <View style={styles.nameRow}>
            <Text style={styles.cardTitle}>
              {item.name}
            </Text>

            <TouchableOpacity onPress={onFavourite}>
              <Text style={styles.heart}>
                {favourite ? "❤️" : "♡"}
              </Text>
            </TouchableOpacity>
          </View>

          {item.verified && (
            <Text style={styles.verified}>
              ✓ VERIFIED
            </Text>
          )}

          <Text style={styles.cardLocation}>
            📍 {item.location}
          </Text>
        </View>
      </View>

      {!!item.description && (
        <Text style={styles.description}>
          {item.description}
        </Text>
      )}

      {!!item.hours && (
        <Text style={styles.meta}>🕐 {item.hours}</Text>
      )}

      {!!item.rating && (
        <Text style={styles.meta}>
          ⭐ {item.rating} ({item.reviews || 0} reviews)
        </Text>
      )}

      {!!item.offer && (
        <View style={styles.offer}>
          <Text style={styles.offerText}>
            🎁 {item.offer}
          </Text>
        </View>
      )}

      <View style={styles.actions}>
        {!!item.phone && (
          <>
            <ActionButton
              icon="📞"
              title="Call"
              onPress={() => callNumber(item.phone)}
              type="green"
            />

            <ActionButton
              icon="💬"
              title="WhatsApp"
              onPress={() => openWhatsApp(item.phone)}
              type="green"
            />
          </>
        )}

        <ActionButton
          icon="📍"
          title="Map"
          onPress={() => openMap(item)}
        />

        {onAdminEdit && (
          <ActionButton
            icon="✏️"
            title="Edit"
            onPress={onAdminEdit}
          />
        )}
      </View>
    </View>
  );
}

