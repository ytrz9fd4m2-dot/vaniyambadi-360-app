/* =========================================================
   CREATE POST
========================================================= */

function CreatePost({
  onBack,
  onPublish,
  defaultType = "post",
}) {
  const [type, setType] = useState(defaultType);
  const [title, setTitle] = useState("");
  const [body, setBody] = useState("");
  const [image, setImage] = useState("");
  const [location, setLocation] = useState(
    "Vaniyambadi"
  );

  function publish() {
    if (!title.trim()) {
      Alert.alert(
        "Publish",
        "Title தேவை."
      );
      return;
    }

    onPublish({
      id: Date.now(),
      type,
      title: title.trim(),
      body: body.trim(),
      image: image.trim(),
      location: location.trim(),
    });

    Alert.alert(
      "Published 🎉",
      "Your content has been published."
    );
  }

  return (
    <ScrollView
      style={styles.page}
      contentContainerStyle={styles.pageContent}
    >
      <BackButton onPress={onBack} />

      <Text style={styles.screenTitle}>
        ＋ Create Content
      </Text>

      <Text style={styles.screenSub}>
        Post • Photo • Reel
      </Text>

      <View style={styles.typeRow}>
        {[
          ["post", "📝 Post"],
          ["photo", "📷 Photo"],
          ["reel", "🎬 Reel"],
        ].map(([value, label]) => (
          <TouchableOpacity
            key={value}
            style={[
              styles.typeButton,
              type === value &&
                styles.typeButtonActive,
            ]}
            onPress={() => setType(value)}
          >
            <Text
              style={[
                styles.typeButtonText,
                type === value &&
                  styles.typeButtonTextActive,
              ]}
            >
              {label}
            </Text>
          </TouchableOpacity>
        ))}
      </View>

      <Input
        label="Title"
        value={title}
        onChange={setTitle}
        placeholder="Post title"
      />

      <Input
        label="Description"
        value={body}
        onChange={setBody}
        placeholder="Write something..."
        multiline
      />

      <Input
        label="Image / Video URL"
        value={image}
        onChange={setImage}
        placeholder="Paste image or video link"
      />

      <Input
        label="Location"
        value={location}
        onChange={setLocation}
        placeholder="Vaniyambadi"
      />

      <TouchableOpacity
        style={styles.primaryButton}
        onPress={publish}
      >
        <Text style={styles.primaryButtonText}>
          🚀 Publish Now
        </Text>
      </TouchableOpacity>

      <Text style={styles.prototypeNote}>
        Prototype: actual image/video storage can be
        connected later with backend storage.
      </Text>
    </ScrollView>
  );
}

