      <View style={styles.specialHeader}>
        <PremiumIcon icon={icon} size={76} />

        <Text style={styles.screenTitle}>
          {title}
        </Text>
      </View>

      {data.map((item, index) => (
        <ListingCard
          key={`${item.name}-${index}`}
          item={item}
